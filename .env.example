# Server-only: never sent to the browser. Used by BFF proxy and login/logout route handlers.
API_ORIGIN=https://api.gadaapp.com

# Browser-facing base URL — points at the same-origin BFF proxy, NOT directly at the API.
# The generated client appends spec paths (which already include /v1), so:
#   /api/gada + /v1/admin/events → /api/gada/v1/admin/events → proxied to API_ORIGIN/v1/admin/events
NEXT_PUBLIC_API_BASE_URL=/api/gada

# Public R2 bucket base URL. Mirrors the API's own R2_PUBLIC_URL.
# Image fields on the API (Event.bannerKey, User.photoKey, VendorProfile.logoKey,
# VendorGallery.imageKey) are storage KEYS, not URLs — lib/utils/media.ts joins
# them onto this base. The bucket currently serves objects publicly, so no
# presign round-trip is needed; if that ever changes, keyToUrl() is the single
# place to swap in a signed-URL call.
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-869f2f380152427485497d3a572f0d7e.r2.dev
